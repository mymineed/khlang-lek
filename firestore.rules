rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(userPath()).data; }
    // ล็อกอินแล้ว + มีโปรไฟล์ + เจ้าของอนุมัติแล้ว (pending / disabled = ห้าม)
    function approved() { return signedIn() && exists(userPath()) && profile().status == 'approved'; }
    function isOwner() { return approved() && profile().role == 'owner'; }

    // ข้อมูลหน้าร้านที่ลูกน้องต้องใช้ขายของ
    // หมายเหตุ: ทุนในบิลขาย (docs.lines.cost) และราคาในบิลซื้อ (buys) ลูกน้องยังอ่านได้ (ตัดสินใจแล้ว: ทาง ข)
    match /{col}/{id} {
      allow read, write: if approved()
        && col in ['moves', 'buys', 'docs', 'cash', 'closes', 'counts', 'orders', 'customers', 'counters'];
    }

    // สินค้า: ห้ามเขียนทุนลง items (ทุนอยู่ที่ itemCosts) แก้ฟิลด์อื่นได้ตามปกติ
    // items.cost เดิม (ก่อนย้าย) ต้องคงค่าเดิม มีแต่เจ้าของที่ลบออกได้ตอนย้ายไป itemCosts
    function costKept() {
      return 'cost' in resource.data
        ? ('cost' in request.resource.data && request.resource.data.cost == resource.data.cost)
        : !('cost' in request.resource.data);
    }
    match /items/{id} {
      allow read, delete: if approved();
      allow create: if approved() && !('cost' in request.resource.data);
      allow update: if approved() && (costKept() || (isOwner() && !('cost' in request.resource.data)));
    }

    // ตั้งค่าร้าน / ราคารับซื้อ / ประวัติปรับราคา: ทุกคนที่อนุมัติแล้วอ่านได้ เจ้าของแก้ได้คนเดียว
    match /settings/{id} {
      allow read: if approved();
      allow write: if isOwner();
    }
    match /prices/{id} {
      allow read: if approved();
      allow write: if isOwner();
    }

    // แผนเงินสด: เจ้าของเท่านั้น
    match /cashplan/{id} {
      allow read, write: if isOwner();
    }

    // ต้นทุนแยก: เจ้าของอ่าน/แก้ได้คนเดียว
    // ลูกน้องเพิ่มได้แค่รายการซื้อเข้าใน pending (อ่านไม่ได้) เครื่องเจ้าของจะคำนวณทุนเฉลี่ยให้
    match /itemCosts/{id} {
      allow read, write: if isOwner();
      allow create: if approved() && request.resource.data.keys().hasOnly(['pending']);
      allow update: if approved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending'])
        && request.resource.data.pending.size() > resource.data.get('pending', []).size();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      // สมัครใหม่ได้เฉพาะโปรไฟล์ของตัวเองในสถานะ staff/pending เท่านั้น
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.status == 'pending';
      // เจ้าของแก้ได้ทุกคน; ผู้ใช้แก้ของตัวเองได้แต่ห้ามแตะ role/status
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid', 'approvedBy', 'approvedAt']));
      allow delete: if isOwner();
    }
  }
}
