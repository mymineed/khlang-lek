rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // รูปบิล/ใบเสร็จที่อัปโหลดจาก assets shim (src/lib/claude-shim.js)
    match /receipts/{file} {
      allow read: if approved();
      allow create, update: if approved()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
